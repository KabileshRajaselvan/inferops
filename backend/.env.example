# For running the backend/scripts/tests locally (outside Docker) against the services
# published by `docker compose up` at the repo root. Copy to backend/.env and adjust as needed.

DATABASE_URL=postgresql+psycopg://inferops:inferops@localhost:5442/inferops
REDIS_URL=redis://localhost:6390/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9095
MLFLOW_TRACKING_URI=http://localhost:5050
MODEL_ARTIFACT_DIR=./model-artifacts
CORS_ORIGINS=http://localhost:5183,http://localhost:5173
